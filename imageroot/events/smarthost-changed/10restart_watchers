# The watchers render their INI (summary email through the smarthost)
# before each start
exec 1>&2
units=$(systemctl --user list-units --plain --no-legend 'parsedmarc-watch@*' | awk '{print $1}')
[[ -n "${units}" ]] && systemctl --user -T try-restart ${units}
exit 0
