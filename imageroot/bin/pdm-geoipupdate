# Download the MaxMind GeoLite2 Country database with the account ID and
# the licence key (secret, sent as HTTP basic credentials, never in argv)

import base64
import io
import os
import sys
import tarfile
import urllib.request
import parsedmarc_ns8 as pdm

settings = pdm.load_settings()
key = pdm.read_secret("maxmind_license_key")
if settings["geoip"] != "maxmind" or not key or not settings["maxmind_account_id"]:
    sys.exit(0)
url = "https://download.maxmind.com/geoip/databases/GeoLite2-Country/download?suffix=tar.gz"
auth = base64.b64encode(f"{settings['maxmind_account_id']}:{key}".encode()).decode()
req = urllib.request.Request(url, headers={"Authorization": "Basic " + auth})
with urllib.request.urlopen(req, timeout=300) as resp:
    data = resp.read()
with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as tar:
    member = next(m for m in tar.getmembers() if m.name.endswith(".mmdb") and m.isfile())
    mmdb = tar.extractfile(member).read()
os.makedirs(pdm.GEOIP_DIR, exist_ok=True)
pdm.write_file(f"{pdm.GEOIP_DIR}/GeoLite2-Country.mmdb", mmdb, 0o644)
print(f"GeoLite2 Country database updated ({len(mmdb)} bytes)", file=sys.stderr)
