# Provision the bundled OpenSearch and Dashboards again (accounts, tenants,
# retention, saved objects): configure-module runs it when the services
# were already running and need no restart.

import parsedmarc_ns8 as pdm

settings = pdm.load_settings()
if pdm.is_bundled(settings):
    pdm.wait_for(pdm.opensearch_ready, 600, "OpenSearch")
    pdm.provision_opensearch(settings)
    if settings["dashboards_enabled"]:
        pdm.wait_for(pdm.dashboards_ready, 600, "OpenSearch Dashboards")
        pdm.provision_dashboards(settings)
