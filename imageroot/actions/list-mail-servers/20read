# IMAP servers of the cluster (ns8-mail and other modules publishing the
# imap service) for the mailbox picker of the UI. No credentials.

import json
import sys
import agent

rdb = agent.redis_connect(use_replica=True)
servers = []
for p in agent.list_service_providers(rdb, "imap", "tcp"):
    servers.append({
        "module_id": p.get("module_id", ""),
        "ui_name": p.get("ui_name") or "",
        "host": p.get("host", ""),
        "port": int(p.get("port") or 143),
        "mail_hostname": p.get("mail_hostname", ""),
        "node": str(p.get("node") or ""),
    })
json.dump({"servers": servers}, fp=sys.stdout)
