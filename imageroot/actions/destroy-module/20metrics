# Remove the alert rules and the dashboard of this instance from the
# cluster metrics module. Its module-removed handler cleans up too; this
# step makes the removal immediate. Never fails the removal.

import os
import sys
import agent
import parsedmarc_metrics as pm

try:
    pm.publish(agent.redis_connect(privileged=True), os.environ["MODULE_ID"], False)
except Exception as ex:
    print(agent.SD_WARNING + f"cluster metrics not removed: {ex}", file=sys.stderr)
