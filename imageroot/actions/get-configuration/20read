import json
import os
import sys
import agent
import parsedmarc_ns8 as pdm

config = pdm.config_view(pdm.load_settings())
config["lets_encrypt"] = agent.get_route(os.environ["MODULE_ID"]).get("lets_encrypt", False) if config["host"] else False
json.dump(config, fp=sys.stdout)
