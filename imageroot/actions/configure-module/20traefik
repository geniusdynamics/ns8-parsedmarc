# Traefik routes: the host serves OpenSearch Dashboards (its own login: the
# administrator and the tenant users); /grafana serves the optional Grafana
# behind the NS8 forward authentication (cluster administrators).

import json
import os
import sys
import agent
import agent.tasks
import parsedmarc_ns8 as pdm

data = json.load(sys.stdin)
settings = pdm.load_settings()
module_id = os.environ["MODULE_ID"]
p = pdm.ports()
traefik = agent.resolve_agent_id("traefik@node")

route = {
    "instance": module_id,
    "url": f"http://127.0.0.1:{p['dashboards']}",
    "host": settings["host"],
    "http2https": settings["http2https"],
    # Kept from the settings when the input omits it (the Tenants page)
    "lets_encrypt": data.get("lets_encrypt", settings["lets_encrypt"]),
}
agent.set_route(route)

if settings["grafana_enabled"]:
    ret = agent.tasks.run(agent_id=traefik, action="set-route", data={
        "instance": module_id + "-grafana",
        "url": f"http://127.0.0.1:{p['grafana']}",
        "host": settings["host"],
        "path": "/grafana",
        "http2https": settings["http2https"],
        "lets_encrypt": False,
        "forward_auth": {
            "address": f"http://127.0.0.1:9311/api/module/{module_id}/http-basic/authorize-grafana",
            "auth_response_headers": ["X-Auth-User"],
        },
    }, extra={"isNotificationHidden": True})
    agent.assert_exp(ret["exit_code"] == 0, "set-route of Grafana failed")
else:
    agent.tasks.run(agent_id=traefik, action="delete-route", data={"instance": module_id + "-grafana"},
                    extra={"isNotificationHidden": True})
